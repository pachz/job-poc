{
  "name": "job-poc",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Job processing POC: React + Convex + Vercel Functions",
  "scripts": {
    "dev": "concurrently -k --names convex,web --prefix-colors blue,green \"npm run dev:convex\" \"npm run dev:web\"",
    "dev:web": "vite",
    "dev:convex": "convex dev",
    "build": "npm run build:server && tsc --noEmit && vite build",
    "build:server": "node scripts/build-server.mjs",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck",
    "convex:codegen": "convex codegen",
    "convex:dashboard": "convex dashboard",
    "convex:deploy": "convex deploy"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pachz/job-poc.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/pachz/job-poc/issues"
  },
  "homepage": "https://github.com/pachz/job-poc#readme",
  "dependencies": {
    "@vercel/functions": "^3.4.3",
    "convex": "^1.45.0",
    "pdf-lib": "^1.17.1",
    "pngjs": "^7.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@convex-dev/eslint-plugin": "^4.0.0",
    "@types/node": "^26.5.0",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vercel/node": "^5.6.16",
    "@vitejs/plugin-react": "^5.1.4",
    "concurrently": "^10.0.5",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^7.3.1"
  }
}
