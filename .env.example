# Convex
CONVEX_URL=
VITE_CONVEX_URL=

# Shared secret between the Vercel Function and Convex mutations that update jobs.
# Defaults to "job-poc-worker" if unset (fine for this POC).
JOB_WORKER_SECRET=

# Cookie signing secret for the login session. Defaults to a local POC value if unset.
SESSION_SECRET=

# Login password. Defaults to 123456.
APP_PASSWORD=123456
